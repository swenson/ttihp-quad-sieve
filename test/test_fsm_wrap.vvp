#! /opt/homebrew/Cellar/icarus-verilog/12.0/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/12.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/12.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/12.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/12.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/12.0/lib/ivl/va_math.vpi";
S_0x101170b30 .scope module, "test_fsm_wrap" "test_fsm_wrap" 2 4;
 .timescale -9 -12;
v0x101177730_0 .var "clk", 0 0;
v0x1011777d0_0 .var "fsm_state", 1 0;
v0x101177870_0 .var "rstn", 0 0;
E_0x1011759f0 .event posedge, v0x101177730_0;
    .scope S_0x101170b30;
T_0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x101177730_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x101177870_0, 0, 1;
    %pushi/vec4 0, 0, 2;
    %store/vec4 v0x1011777d0_0, 0, 2;
    %end;
    .thread T_0;
    .scope S_0x101170b30;
T_1 ;
    %delay 5000, 0;
    %load/vec4 v0x101177730_0;
    %inv;
    %store/vec4 v0x101177730_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x101170b30;
T_2 ;
    %vpi_call 2 12 "$dumpfile", "test_fsm_wrap.fst" {0 0 0};
    %vpi_call 2 13 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x101170b30 {0 0 0};
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x101177870_0, 0, 1;
    %pushi/vec4 10, 0, 32;
T_2.0 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_2.1, 5;
    %jmp/1 T_2.1, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %wait E_0x1011759f0;
    %jmp T_2.0;
T_2.1 ;
    %pop/vec4 1;
    %vpi_call 2 20 "$display", "Final fsm_state = %d (should be 0)", v0x1011777d0_0 {0 0 0};
    %load/vec4 v0x1011777d0_0;
    %pad/u 32;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_2.2, 4;
    %vpi_call 2 22 "$display", "PASS: FSM wrapped correctly" {0 0 0};
    %jmp T_2.3;
T_2.2 ;
    %vpi_call 2 24 "$display", "FAIL: FSM did not wrap" {0 0 0};
T_2.3 ;
    %vpi_call 2 26 "$finish" {0 0 0};
    %end;
    .thread T_2;
    .scope S_0x101170b30;
T_3 ;
    %wait E_0x1011759f0;
    %load/vec4 v0x101177870_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_3.0, 8;
    %pushi/vec4 0, 0, 2;
    %assign/vec4 v0x1011777d0_0, 0;
    %jmp T_3.1;
T_3.0 ;
    %vpi_call 2 33 "$display", "t=%0t fsm_state=%d", $time, v0x1011777d0_0 {0 0 0};
    %load/vec4 v0x1011777d0_0;
    %addi 1, 0, 2;
    %assign/vec4 v0x1011777d0_0, 0;
T_3.1 ;
    %jmp T_3;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 3;
    "N/A";
    "<interactive>";
    "test_fsm_wrap.v";
